datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Baseline table for Phase 1 infrastructure verification
model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Phase 3 Authentication & Identity Models

model Organization {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  logoUrl          String?  @map("logo_url") @db.Text
  billingEmail     String   @map("billing_email") @db.VarChar(255)
  subscriptionTier String   @default("FREE") @map("subscription_tier") @db.VarChar(50)
  defaultCurrency  String   @default("USD") @map("default_currency") @db.VarChar(3)
  defaultTimezone  String   @default("UTC") @map("default_timezone") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members             OrganizationMember[]
  invitations         OrganizationInvitation[]
  agreementCategories AgreementCategory[]
  agreements          Agreement[]
  activityLogs        ActivityLog[]
  referenceCounters   OrganizationReferenceCounter[]
  idempotencyKeys     IdempotencyKey[]

  @@index([slug], map: "idx_org_slug")
  @@map("organizations")
}

model User {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String    @unique @db.VarChar(255)
  passwordHash               String?   @map("password_hash") @db.VarChar(255)
  authProvider               String    @default("LOCAL") @map("auth_provider") @db.VarChar(50)
  providerId                 String?   @map("provider_id") @db.VarChar(255)
  isEmailVerified            Boolean   @default(false) @map("is_email_verified")
  verificationTokenHash      String?   @map("verification_token_hash") @db.VarChar(64)
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at") @db.Timestamptz
  passwordResetTokenHash     String?   @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz
  lastLoginAt                DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts        Int       @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime? @map("locked_until") @db.Timestamptz
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile           UserProfile?
  memberships       OrganizationMember[]
  sessions          UserSession[]
  sentInvitations   OrganizationInvitation[] @relation("InvitedByUser")
  createdAgreements Agreement[]              @relation("AgreementCreator")
  activityLogs      ActivityLog[]
  agreementVersions AgreementVersion[]
  idempotencyKeys   IdempotencyKey[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserProfile {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                       String   @unique @map("user_id") @db.Uuid
  firstName                    String   @map("first_name") @db.VarChar(100)
  lastName                     String   @map("last_name") @db.VarChar(100)
  displayName                  String?  @map("display_name") @db.VarChar(200)
  phoneNumber                  String?  @map("phone_number") @db.VarChar(50)
  avatarUrl                    String?  @map("avatar_url") @db.Text
  jobTitle                     String?  @map("job_title") @db.VarChar(150)
  themePreference              String   @default("system") @map("theme_preference") @db.VarChar(10)
  emailNotificationPreferences Json     @default("{\"on_signature_requested\": true, \"on_agreement_signed\": true, \"on_agreement_completed\": true, \"on_reminder\": true}") @map("email_notification_preferences")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("MEMBER") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "uq_org_user")
  @@index([userId], map: "idx_org_members_user")
  @@index([organizationId, role], map: "idx_org_members_org_role")
  @@map("organization_members")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(64)
  familyId         String   @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  userAgent        String?  @map("user_agent") @db.Text
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_hash")
  @@index([familyId], map: "idx_sessions_family_id")
  @@map("user_sessions")
}

model OrganizationInvitation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  email               String    @db.VarChar(255)
  role                String    @default("MEMBER") @db.VarChar(50)
  invitationTokenHash String    @map("invitation_token_hash") @db.VarChar(64)
  invitedBy           String    @map("invited_by") @db.Uuid
  status              String    @default("PENDING") @db.VarChar(50)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_org_invitations_org")
  @@index([email], map: "idx_org_invitations_email")
  @@index([invitationTokenHash], map: "idx_org_invitations_token_hash")
  @@map("organization_invitations")
}

// Phase 4 Agreement & Analytics Read Models

model AgreementCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?  @map("organization_id") @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @db.VarChar(100)
  description     String?  @db.Text
  iconName        String   @default("FileText") @map("icon_name") @db.VarChar(50)
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreements   Agreement[]
  templateClauses AgreementCategoryClause[]

  @@index([slug], map: "idx_categories_slug")
  @@index([organizationId], map: "idx_categories_org")
  @@map("agreement_categories")
}

model Agreement {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber       String    @map("reference_number") @db.VarChar(100)
  organizationId        String    @map("organization_id") @db.Uuid
  creatorId             String    @map("creator_id") @db.Uuid
  categoryId            String    @map("category_id") @db.Uuid
  title                 String    @db.VarChar(300)
  description           String?   @db.Text
  status                String    @default("DRAFT") @db.VarChar(50)
  signingOrder          String    @default("PARALLEL") @map("signing_order") @db.VarChar(20)
  currentSignerSequence Int       @default(1) @map("current_signer_sequence")
  totalSignersCount     Int       @default(0) @map("total_signers_count")
  completedSignersCount Int       @default(0) @map("completed_signers_count")
  effectiveDate         DateTime? @map("effective_date") @db.Date
  expirationDate        DateTime? @map("expiration_date") @db.Date
  completedAt           DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason    String?   @map("cancellation_reason") @db.Text
  rejectionReason       String?   @map("rejection_reason") @db.Text
  isArchived            Boolean   @default(false) @map("is_archived")
  rowVersion            Int       @default(1) @map("row_version")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User              @relation("AgreementCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  category     AgreementCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  parties      AgreementParty[]
  clauses      AgreementClause[]
  paymentTerms AgreementPaymentTerm?
  auditEvents  AuditEvent[]
  versions     AgreementVersion[]

  @@unique([organizationId, referenceNumber], name: "uq_org_reference")
  @@index([organizationId, status], map: "idx_agreements_org_status")
  @@index([organizationId, createdAt], map: "idx_agreements_org_created_at")
  @@index([organizationId, deletedAt], map: "idx_agreements_org_deleted_at")
  @@index([expirationDate], map: "idx_agreements_expiration")
  @@index([categoryId], map: "idx_agreements_category")
  @@index([creatorId], map: "idx_agreements_creator")
  @@map("agreements")
}

model AgreementParty {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreementId     String    @map("agreement_id") @db.Uuid
  partyType       String    @default("COUNTERPARTY") @map("party_type") @db.VarChar(50)
  name            String    @db.VarChar(255)
  companyName     String?   @map("company_name") @db.VarChar(255)
  email           String    @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  role            String    @default("SIGNER") @db.VarChar(50)
  signingSequence Int       @default(1) @map("signing_sequence")
  status          String    @default("PENDING") @db.VarChar(50)
  signedAt        DateTime? @map("signed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, email], name: "uq_agreement_party_email")
  @@index([agreementId], map: "idx_agreement_parties_agreement")
  @@index([email], map: "idx_agreement_parties_email")
  @@map("agreement_parties")
}

model AgreementClause {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreementId      String   @map("agreement_id") @db.Uuid
  sectionNumber    String   @map("section_number") @db.VarChar(20)
  title            String   @db.VarChar(300)
  content          String   @db.Text
  isStandardClause Boolean  @default(true) @map("is_standard_clause")
  isMandatory      Boolean  @default(true) @map("is_mandatory")
  displayOrder     Int      @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, displayOrder], map: "idx_clauses_agreement_order")
  @@map("agreement_clauses")
}

model AgreementPaymentTerm {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreementId     String   @unique @map("agreement_id") @db.Uuid
  totalAmount     Decimal? @map("total_amount") @db.Decimal(14, 2)
  currency        String   @default("USD") @db.VarChar(3)
  paymentSchedule String   @default("MILESTONE") @map("payment_schedule") @db.VarChar(50)
  billingNotes    String?  @map("billing_notes") @db.Text
  milestones      Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@map("agreement_payment_terms")
}

model AuditEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreementId       String   @map("agreement_id") @db.Uuid
  seq               Int      @default(1)
  eventType         String   @map("event_type") @db.VarChar(100)
  actorType         String   @map("actor_type") @db.VarChar(50)
  actorId           String?  @map("actor_id") @db.Uuid
  actorName         String   @map("actor_name") @db.VarChar(255)
  actorEmail        String   @map("actor_email") @db.VarChar(255)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent") @db.Text
  payload           Json     @default("{}")
  previousEventHash String   @map("previous_event_hash") @db.VarChar(64)
  eventHash         String   @map("event_hash") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)

  @@unique([agreementId, seq], name: "uq_audit_agreement_seq")
  @@index([agreementId, seq], map: "idx_audit_events_agreement_seq")
  @@index([agreementId, createdAt], map: "idx_audit_events_agreement")
  @@map("audit_events")
}

model ActivityLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String?  @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_activity_logs_org_date")
  @@map("activity_logs")
}

// Phase 5 Agreement Creation Engine Models

model AgreementVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreementId   String   @map("agreement_id") @db.Uuid
  versionNumber Int      @map("version_number")
  content       Json     @db.JsonB
  contentHash   String   @map("content_hash") @db.VarChar(64)
  createdBy     String   @map("created_by") @db.Uuid
  changeSummary String?  @map("change_summary") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([agreementId, versionNumber], name: "uq_agreement_version")
  @@index([agreementId, versionNumber], map: "idx_agreement_versions_num")
  @@map("agreement_versions")
}

model AgreementCategoryClause {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  sectionNumber String   @map("section_number") @db.VarChar(20)
  title         String   @db.VarChar(300)
  content       String   @db.Text
  isMandatory   Boolean  @default(true) @map("is_mandatory")
  displayOrder  Int      @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category AgreementCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, displayOrder], map: "idx_cat_clauses_order")
  @@map("agreement_category_clauses")
}

model OrganizationReferenceCounter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  year           Int
  lastNumber     Int      @default(0) @map("last_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year], name: "uq_org_reference_counter")
  @@map("organization_reference_counters")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @db.VarChar(255)
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key], name: "uq_org_idempotency_key")
  @@index([expiresAt], map: "idx_idempotency_expires_at")
  @@map("idempotency_keys")
}
