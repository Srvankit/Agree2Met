datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Baseline table for Phase 1 infrastructure verification
model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Phase 3 Authentication & Identity Models

model Organization {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  logoUrl          String?  @map("logo_url") @db.Text
  billingEmail     String   @map("billing_email") @db.VarChar(255)
  subscriptionTier String   @default("FREE") @map("subscription_tier") @db.VarChar(50)
  defaultCurrency  String   @default("USD") @map("default_currency") @db.VarChar(3)
  defaultTimezone  String   @default("UTC") @map("default_timezone") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@index([slug], map: "idx_org_slug")
  @@map("organizations")
}

model User {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String    @unique @db.VarChar(255)
  passwordHash               String?   @map("password_hash") @db.VarChar(255)
  authProvider               String    @default("LOCAL") @map("auth_provider") @db.VarChar(50)
  providerId                 String?   @map("provider_id") @db.VarChar(255)
  isEmailVerified            Boolean   @default(false) @map("is_email_verified")
  verificationTokenHash      String?   @map("verification_token_hash") @db.VarChar(64)
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at") @db.Timestamptz
  passwordResetTokenHash     String?   @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz
  lastLoginAt                DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts        Int       @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime? @map("locked_until") @db.Timestamptz
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile         UserProfile?
  memberships     OrganizationMember[]
  sessions        UserSession[]
  sentInvitations OrganizationInvitation[] @relation("InvitedByUser")

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserProfile {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                       String   @unique @map("user_id") @db.Uuid
  firstName                    String   @map("first_name") @db.VarChar(100)
  lastName                     String   @map("last_name") @db.VarChar(100)
  displayName                  String?  @map("display_name") @db.VarChar(200)
  phoneNumber                  String?  @map("phone_number") @db.VarChar(50)
  avatarUrl                    String?  @map("avatar_url") @db.Text
  jobTitle                     String?  @map("job_title") @db.VarChar(150)
  themePreference              String   @default("system") @map("theme_preference") @db.VarChar(10)
  emailNotificationPreferences Json     @default("{\"on_signature_requested\": true, \"on_agreement_signed\": true, \"on_agreement_completed\": true, \"on_reminder\": true}") @map("email_notification_preferences")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("MEMBER") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "uq_org_user")
  @@index([userId], map: "idx_org_members_user")
  @@index([organizationId, role], map: "idx_org_members_org_role")
  @@map("organization_members")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(64)
  familyId         String   @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  userAgent        String?  @map("user_agent") @db.Text
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_hash")
  @@index([familyId], map: "idx_sessions_family_id")
  @@map("user_sessions")
}

model OrganizationInvitation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  email               String    @db.VarChar(255)
  role                String    @default("MEMBER") @db.VarChar(50)
  invitationTokenHash String    @map("invitation_token_hash") @db.VarChar(64)
  invitedBy           String    @map("invited_by") @db.Uuid
  status              String    @default("PENDING") @db.VarChar(50)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_org_invitations_org")
  @@index([email], map: "idx_org_invitations_email")
  @@index([invitationTokenHash], map: "idx_org_invitations_token_hash")
  @@map("organization_invitations")
}
