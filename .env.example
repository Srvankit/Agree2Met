# ==========================================
# Agree2Met - Environment Configuration Template
# Phase 1: Foundation & Development Infrastructure
# ==========================================

# Application Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16 in Docker on port 5433)
DATABASE_URL=postgresql://agree2met:agree2met_dev_pass@localhost:5433/agree2met_db?schema=public

# Cache & Queues (Redis 7)
REDIS_URL=redis://localhost:6379

# Object Storage (S3-Compatible Storage)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=agree2met-dev
STORAGE_REGION=us-east-1

# Transactional Email (Mailpit Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agree2Met <no-reply@agree2met.local>"

# Security & Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
